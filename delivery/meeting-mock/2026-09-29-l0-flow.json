   "html": "\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  var QSTAGE = {\"Q1\": \"S0\", \"Q2\": \"S0\", \"Q3\": \"S2\", \"Q4\": \"S2\", \"Q5\": \"S2\", \"Q6\": \"S3\", \"Q7\": \"S3\", \"Q8\": \"S4\", \"Q9\": \"S4\", \"Q10\": \"S5\", \"Q11\": \"S5\", \"Q12\": \"S5\", \"Q13\": \"S6\"}, GATED = [\"S2\", \"S3\", \"S4\", \"S5\", \"S6\"], STATIC = {\"S0\": \"todo\", \"S1\": \"done\", \"S2\": \"partial\", \"S3\": \"todo\", \"S4\": \"partial\", \"S5\": \"todo\", \"S6\": \"partial\", \"S7\": \"locked\", \"S8\": \"locked\"};\n  var NAMES = {\"S0\": \"準備\", \"S1\": \"企画\", \"S2\": \"要件定義\", \"S3\": \"情報設計\", \"S4\": \"ワイヤーフレーム\", \"S5\": \"ビジュアル方針\", \"S6\": \"プロトタイプ\", \"S7\": \"確認\", \"S8\": \"確定\"};\n  function sel(q) { return Array.prototype.map.call(document.querySelectorAll('.opts[data-q=\"' + q + '\"] .opt.selected'), function (b) { return b.getAttribute('data-k'); }); }\n  function qsOf(s) { return Object.keys(QSTAGE).filter(function (q) { return QSTAGE[q] === s; }); }\n  function stageDone(s) { var qs = qsOf(s); return qs.length > 0 && qs.every(function (q) { return sel(q).length > 0; }); }\n  function bubble(q, cls, text) {\n    var art = document.getElementById(q); if (!art) return;\n    var b = document.createElement('div'); b.className = 'qbubble ' + (cls || ''); b.innerHTML = text; art.appendChild(b);\n  }\n  function update() {\n    var off = document.getElementById('gateOff').checked;\n    document.querySelectorAll('.qbubble,.lockbar').forEach(function (e) { e.remove(); });\n    // 1) 段階ごとの解放\n    var open = true, now = null;\n    GATED.forEach(function (s) {\n      qsOf(s).forEach(function (q) {\n        var art = document.getElementById(q); if (!art) return;\n        var lock = !open && !off;\n        art.classList.toggle('locked', lock);\n        if (lock) { var bar = document.createElement('div'); bar.className = 'lockbar'; bar.textContent = '🔒 前の段階（' + now + ' ' + NAMES[now] + '）の問いに全部答えると解放されます'; art.insertBefore(bar, art.firstChild); }\n      });\n      if (open && !stageDone(s)) { open = false; now = s; }\n    });\n    // 2) 段階の表示\n    document.querySelectorAll('#rail .st').forEach(function (li) {\n      var s = li.getAttribute('data-stage'), base = STATIC[s];\n      li.className = 'st';\n      var qs = qsOf(s), answered = qs.filter(function (q) { return sel(q).length; }).length;\n      var st = base;\n      if (qs.length) { st = answered === qs.length ? 'done' : (answered ? 'partial' : base); }\n      if (GATED.indexOf(s) >= 0 && GATED.indexOf(s) > GATED.indexOf(now || 'S9') && !off && st !== 'done') st = 'locked';\n      li.classList.add('st-' + st); if (s === now) li.classList.add('st-now');\n      var bb = li.querySelector('.bubble');\n      if (bb && qs.length) {\n        if (answered === qs.length) { bb.classList.add('ok'); bb.textContent = '回答済み。回答を貼り戻すと AI が埋める'; }\n        else if (answered) { bb.classList.remove('ok'); bb.textContent = 'あと ' + (qs.length - answered) + ' 問（' + qs.filter(function (q) { return !sel(q).length; }).join('・') + '）'; }\n      }\n    });\n    // 3) 問いどうしの食い違いを吹き出しで出す\n    var s6 = sel('Q6');\n    if (s6.length && s6.indexOf('C') < 0) bubble('Q6', '', '⚠ 前回の決定（区分を会議ごとにカスタム）と食い違います。<b>テンプレート編集画面</b>が無いと、利用者がテンプレートを作れません');\n    if (s6.length && s6.indexOf('D') < 0 && sel('Q7')[0] === 'A') bubble('Q7', '', '⚠ Q7 で「出力を確認してから保存」を選ぶなら、Q6 で<b>終了・出力確認</b>の画面も要ります');\n    if (sel('Q9')[0] === 'B') bubble('Q9', '', '⚠ 前回の決定「ボタン 1 つで切替」と比べると、確認を挟むぶん操作が 2 回になります');\n    var s5 = sel('Q5')[0];\n    if (s5 === 'B' || s5 === 'C') bubble('Q5', 'info', 'SPEC に機能 F12 を追加します。' + (s5 === 'C' ? 'モック生成の解放条件が増えるので、P1b の範囲が広がります' : 'ドキュメント更新の出力に「不足一覧」を足すだけなので、呼び出し回数は増えません'));\n    if (sel('Q11')[0] === 'D') bubble('Q11', 'info', 'メモ欄に会社のブランドカラー（色コード）を書いてください');\n    var s3 = sel('Q3');\n    if (s3.indexOf('E') >= 0 && s3.length > 1) bubble('Q3', '', '⚠ 「特になし」と他の選択肢が同時に選ばれています');\n  }\n  document.addEventListener('click', function (e) { if (e.target.closest('.opt') || e.target.id === 'clear') setTimeout(update, 0); });\n  document.getElementById('gateOff').addEventListener('change', update);\n  // 段階タグを問いの見出しへ\n  Object.keys(QSTAGE).forEach(function (q) { var h = document.querySelector('#' + q + ' .q-title'); if (h) h.insertAdjacentHTML('beforeend', '<span class=\"stage-tag\">' + QSTAGE[q] + ' ' + NAMES[QSTAGE[q]] + '</span>'); });\n  update();\n});\n</script>\n"
  }
 ],
 "foot": "推奨は AI の見立てであって決定ではない（最終承認は人間）。段階の解放と吹き出しはこのページの中だけで動き、回答はブラウザにだけ残る。回答まとめをコピーしてチャットに貼り戻す。",
