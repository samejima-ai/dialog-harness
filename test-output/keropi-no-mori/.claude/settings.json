{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm exec *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(vite *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(biome *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(tsc *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Read(**/*)",
      "Edit(**/*)",
      "Write(**/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(npm publish*)"
    ]
  },
  "env": {
    "PROJECT_NAME": "keropi-no-mori",
    "HARNESS_VERSION": "v4.2",
    "MODE": "M2"
  }
}
