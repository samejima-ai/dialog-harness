# auto-merge — stop ラベル opt-out による PR 自動 merge
#
# このファイルは dialog-harness v5.6.0 の template (`templates/github-workflows/auto-merge.yml.template`) から
# `crosscut-autonomous-drive` skill が placeholder 置換して `.github/workflows/auto-merge.yml` に配置したものです。
# 詳細は dialog-harness の `crosscut-autonomous-drive/references/placeholder-spec.md` 参照。
# v5.9.0 で opt-in→opt-out 反転、境界 SPEC は dialog-harness の
# `crosscut-autonomous-drive/references/auto-merge-boundary.md` を一次情報源とする。
#
# 利用者プロジェクト固有の設定値:
#   ${ALLOWED_AUTHORS}: 信頼済 author の login 名（複数なら space 区切り）
#
# v5.5.3 で追加（label opt-in モデル）、v5.9.0 で opt-out モデルに反転。
# DH の crosscut-issue-implementer から続く autonomous-drive 機構の出口側
# （issue → AI 実装 → 多層レビュー → 自動 merge のうち最終段階）。
#
# v5.9.0 反転の根拠:
#   - DH 本体の Council 諮問 council-2026-05-06T08:30:00Z-amrev1（unanimous C ハイブリッド、
#     judgment_confidence 0.80、implementer_consent: agreed_with_modification）
#   - opt-out モデルは「人間は多少のことは無関心、暗黙オートが基本」を体現
#   - 境界の SPEC 不変化は auto-merge-boundary.md に明記、AI が境界を動かせない
#
# 動作: 以下の全条件を満たした場合のみ PR を squash merge する
#   1. PR に stop ラベル（`do-not-merge` / `human-review-needed` / `pickup-failed`）が
#      ついて **いない**（v5.9.0 で whitelist → blacklist へ反転）
#   2. PR が non-draft
#   3. author が ALLOWED_AUTHORS（信頼済 list）に含まれる
#   4. harness-verify check が SUCCESS（構造的検証）
#   5. gemini-review が走った場合 SUCCESS 必須（走らなかった = paths filter
#      で対象外、その場合は条件クリア扱い）
#   6. reviewDecision が CHANGES_REQUESTED でない
#   7. PR state が OPEN
#   4.5（zero-check 防止）. harness-verify / gemini-review の最低どちらか 1 つが
#       SUCCESS で走っていること（両方未実行の paths filter 外 PR を防ぐ）
#
# 非該当 PR は notice 出力で skip（red CI にしない）。
#
# 設計判断:
# - GitHub native auto-merge ではなく workflow で直接 merge する形を採用
#   理由: branch protection の設定変更を伴わず運用できる、ロジックを
#   一箇所で管理できる、運用観測（notice ログ）が一元化される
# - opt-out（blacklist）反転: opt-in（whitelist）は人間の能動的同意を要求するが
#   人間は多くの PR に無関心。opt-out では沈黙が暗黙承認となり流速が劇的改善する。
#   tail-risk 抑制は opt-in 領域（auto-merge-boundary.md §opt-in 領域）の維持で担保
# - PAT (GH_REVIEW_PAT) を使用: workflow の auto GITHUB_TOKEN は別 workflow を
#   trigger できない（無限ループ防止）が、PAT なら trigger 可能。本 workflow 自身は
#   別 workflow を起動しないが、merge commit が後続 workflow を起こす可能性は許容
# - 自動 merge 後は branch を削除（--delete-branch、ノイズ削減）
#
# 必要な setup:
# - Repo Settings → Secrets に GH_REVIEW_PAT が設定済（v5.5.1 で導入）
# - GitHub UI で `do-not-merge` / `human-review-needed` ラベルを作成（手動、初回のみ）
#   旧 `auto-merge` ラベルは v5.9.0 で廃止、deployment では作成しない
#
# 信頼済 author list の拡張:
# - 本 workflow の env.ALLOWED_AUTHORS を更新する PR を出す（spec 改修扱い）
# - 別 contributor を追加する場合は L0 spec-architect 経由で REGIME.md と整合確認

name: auto-merge

on:
  pull_request:
    types: [labeled, unlabeled, opened, synchronize, ready_for_review, reopened]
  pull_request_review:
    types: [submitted, dismissed]
  check_suite:
    types: [completed]

permissions:
  contents: write
  pull-requests: write
  checks: read

# 同 PR の並行実行を排他（多 event で同時 merge を防ぐ）
concurrency:
  group: "auto-merge-${{ github.event.pull_request.number || github.event.check_suite.head_sha }}"
  cancel-in-progress: false

env:
  # 信頼済 author list（space 区切り）。本 workflow を信頼する author を列挙。
  # 拡張時は spec-architect 経由で REGIME.md と整合確認のうえ更新する
  # PLACEHOLDER: ${ALLOWED_AUTHORS} は spec-architect 対話で確定、複数の場合は space 区切り
  ALLOWED_AUTHORS: "${ALLOWED_AUTHORS}"

jobs:
  evaluate:
    # bot 作者 + dependabot を skip（無限ループ / 想定外 merge を防ぐ）
    if: |
      github.event.pull_request.user.login != 'dependabot[bot]' &&
      github.event.pull_request.user.login != 'github-actions[bot]'
    runs-on: ubuntu-latest
    timeout-minutes: 30  # 条件 3.5 の全 CI 完了ポーリングを吸収。最長の check（claude-review 等）の
                         # 実行時間を待ち切れる値に揃える。短い timeout だと長い review 中に exit→
                         # 再 trigger が来ず永続未 merge になる。
    # job レベル env: gh CLI に必要な認証 + repo 指定（v5.5.3 PR #42 初回 run で
    # checkout なし環境で gh pr view が "not a git repository" fatal を起こした
    # ため、GH_REPO で git context 不要にする）
    env:
      GH_TOKEN: ${{ secrets.GH_REVIEW_PAT }}
      GH_REPO: ${{ github.repository }}
    steps:
      # Pre-check: GH_REVIEW_PAT が available か（Copilot review #42 line 89）
      # gemini-review.yml の GEMINI_API_KEY check と同形式。fork PR / secret 欠落
      # 環境で gh が auth fail → red CI を防ぐ
      #
      # v6.17.0 F7: **存在**だけでなく**有効性**も見る。
      #   旧版は `-z` の存在検査のみで、secret が失効していると available=true のまま
      #   後段の `gh pr view` が `HTTP 401: Bad credentials` で exit 1 になり、
      #   「非該当 PR は notice で skip（red CI にしない）」という本 workflow の設計方針が
      #   破れて**全 PR が red になる**（2026-09-05 実測: PR #247 の 3 head すべてで再現）。
      #   失効は人間専管（secrets 再発行）ゆえ AI は直せない。ゆえに red ではなく skip に倒す。
      - name: Check GH_REVIEW_PAT availability
        id: check_pat
        env:
          GH_REVIEW_PAT_PROBE: ${{ secrets.GH_REVIEW_PAT }}
        run: |
          if [ -z "$GH_REVIEW_PAT_PROBE" ]; then
            echo "::notice::GH_REVIEW_PAT 未設定（fork PR や secret 欠落環境）。auto-merge を skip。"
            echo "available=false" >> "$GITHUB_OUTPUT"
          elif ! GH_TOKEN="$GH_REVIEW_PAT_PROBE" gh api user --silent >/dev/null 2>&1; then
            echo "::notice::GH_REVIEW_PAT が無効（401 Bad credentials 等）。auto-merge を skip（red にしない）。secret の再発行は人間専管。"
            echo "available=false" >> "$GITHUB_OUTPUT"
          else
            echo "available=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Resolve PR number
        id: resolve
        if: steps.check_pat.outputs.available == 'true'
        run: |
          set -euo pipefail
          PR_NUMBER=""

          case "${{ github.event_name }}" in
            pull_request|pull_request_review)
              PR_NUMBER="${{ github.event.pull_request.number }}"
              ;;
            check_suite)
              HEAD_SHA="${{ github.event.check_suite.head_sha }}"
              # SHA から open PR を逆引き（Copilot review #42 line 89: 複数 PR
              # で先頭採用は非決定性。複数 hit 時は曖昧として skip し、明示 push
              # event を待つ。同 SHA に複数 open PR は shared-head / retargeted
              # branch シナリオで起こりうる）
              PRS_JSON=$(gh api "repos/${{ github.repository }}/commits/$HEAD_SHA/pulls" \
                --jq '[.[] | select(.state == "open")]')
              PR_COUNT=$(echo "$PRS_JSON" | jq 'length')
              if [ "$PR_COUNT" = "0" ]; then
                : # PR_NUMBER は空のまま
              elif [ "$PR_COUNT" = "1" ]; then
                PR_NUMBER=$(echo "$PRS_JSON" | jq -r '.[0].number')
              else
                echo "::warning::SHA $HEAD_SHA に複数 open PR ($PR_COUNT 件)。merge target が曖昧なため skip（明示 push / pull_request event を待つ）。"
              fi
              ;;
          esac

          if [ -z "$PR_NUMBER" ]; then
            echo "::notice::PR を解決できませんでした (event: ${{ github.event_name }})。skip。"
            echo "pr_number=" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::評価対象: PR #$PR_NUMBER"
            echo "pr_number=$PR_NUMBER" >> "$GITHUB_OUTPUT"
          fi

      - name: Evaluate conditions and merge
        if: steps.check_pat.outputs.available == 'true' && steps.resolve.outputs.pr_number != ''
        env:
          PR_NUMBER: ${{ steps.resolve.outputs.pr_number }}
        run: |
          set -euo pipefail

          # PR 詳細を一括取得
          # field set は初回と条件 3.5 のポーリング再取得で共用（マジック文字列の二重定義回避）
          PR_FIELDS="author,labels,isDraft,state,statusCheckRollup,reviewDecision,title,baseRefName,files"
          PR_JSON=$(gh pr view "$PR_NUMBER" --json "$PR_FIELDS")

          # 条件 7: PR state OPEN
          STATE=$(echo "$PR_JSON" | jq -r '.state')
          if [ "$STATE" != "OPEN" ]; then
            echo "::notice::PR #$PR_NUMBER state=$STATE。skip。"
            exit 0
          fi

          # 条件 1: stop ラベル不在（v5.9.0 で opt-in→opt-out 反転、
          # auto-merge-boundary.md §stop ラベル定義 参照）
          STOP_LABEL=$(echo "$PR_JSON" | jq -r '[.labels[]? | select(.name == "do-not-merge" or .name == "human-review-needed" or .name == "pickup-failed")] | .[0].name // ""')
          if [ -n "$STOP_LABEL" ]; then
            echo "::notice::PR #$PR_NUMBER に stop ラベル '$STOP_LABEL' あり。skip（人間レビュー or 差し戻し or pickup 失敗）。"
            exit 0
          fi

          # 条件 1.5（v6.12.0・Council 634df2）: CTL 権限ゲート。
          #
          # **単調性制約（哲学者）**: CTL は本 workflow で「止める」方向にのみ効く。
          # CTL が高いことを理由に merge 条件を**緩めることはしない**（既存条件は全て AND のまま）。
          # 権限の拡張判断は対話セッション内で人間の面前でのみ発火する。
          #
          # **自己昇格の遮断（開発者）**: .council-ctl.json 自身を触る PR は必ず止める。
          # これが無いと PR が自分の merge 可否を書き換えられる（自己昇格経路）。
          CTL_FILE=".council-ctl.json"
          CHANGED=$(echo "$PR_JSON" | jq -r '.files[]?.path // empty')
          if echo "$CHANGED" | grep -qx "$CTL_FILE"; then
            echo "::notice::PR #$PR_NUMBER が $CTL_FILE を改変している。skip（権限値の自己昇格を遮断・Council 634df2 開発者制約）。"
            exit 0
          fi

          # **鮮度 fail-closed（開発者・経営者）**: 導出結果が古ければ CTL-0 相当に落とす。
          # 実体（user-scope council-data）は CI から見えないため、鮮度だけが乖離検知の手段。
          #
          # 本 job は checkout を持たない（§env の GH_REPO で git context を代替）ため、
          # ファイルは base ブランチから API で取得する。PR 側の版を読むと、上の
          # 自己昇格遮断をすり抜けた改変を信じることになるので **base 固定**が必須。
          BASE_REF=$(echo "$PR_JSON" | jq -r '.baseRefName // "master"')
          CTL_JSON=$(gh api "repos/{owner}/{repo}/contents/$CTL_FILE?ref=$BASE_REF" \
            --jq '.content' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          if [ -n "$CTL_JSON" ]; then
            CTL_LEVEL=$(echo "$CTL_JSON" | jq -r '.ctl // "CTL-0"' 2>/dev/null || echo "CTL-0")
            CTL_AT=$(echo "$CTL_JSON" | jq -r '.ctl_calculated_at // ""' 2>/dev/null || echo "")
            CTL_STALE_DAYS="${CTL_STALE_DAYS:-30}"
            if [ -n "$CTL_AT" ]; then
              AGE_SEC=$(( $(date -u +%s) - $(date -u -d "$CTL_AT" +%s 2>/dev/null || echo 0) ))
              if [ "$AGE_SEC" -gt $(( CTL_STALE_DAYS * 86400 )) ]; then
                echo "::warning::$CTL_FILE が $CTL_STALE_DAYS 日超（$CTL_AT）。CTL-0 相当として扱う（fail-closed）。"
                CTL_LEVEL="CTL-0"
              fi
            else
              echo "::warning::$CTL_FILE に ctl_calculated_at が無い。CTL-0 相当として扱う（fail-closed）。"
              CTL_LEVEL="CTL-0"
            fi
            # CTL-0 = 全件人間献上。自動 merge は権限外。
            if [ "$CTL_LEVEL" = "CTL-0" ]; then
              echo "::notice::CTL-0（全件献上）のため auto-merge を行わない。skip。"
              exit 0
            fi
            echo "::notice::CTL ゲート通過: $CTL_LEVEL（縮小方向のみ適用）。"
          else
            # ファイル不在は「まだ配線していない」状態。既存挙動を変えない（後方互換）。
            echo "::notice::$CTL_FILE 不在。CTL ゲートを適用せず既存条件のみで判定する。"
          fi

          # 条件 2: non-draft
          if [ "$(echo "$PR_JSON" | jq -r '.isDraft')" = "true" ]; then
            echo "::notice::PR #$PR_NUMBER は draft。skip。"
            exit 0
          fi

          # 条件 3: author allowlist
          AUTHOR=$(echo "$PR_JSON" | jq -r '.author.login')
          if ! echo " $ALLOWED_AUTHORS " | grep -q " $AUTHOR "; then
            echo "::notice::author '$AUTHOR' が ALLOWED_AUTHORS 外。skip（信頼済 list 拡張は spec-architect 経由）。"
            exit 0
          fi

          # 条件 3.5（全 CI 完了待ち）: 自分（evaluate）以外の **全 check** が COMPLETED に
          # なるまで、その場でポーリングして待つ。timeout 到達時のみ exit 0
          # （次の push / label / review event で再評価）。
          #
          # ねらい:
          # - verify / review だけでなく copilot-pull-request-reviewer 等
          #   **すべての CI 処理の完了を待ってから** merge する（早すぎる merge の防止）。
          # - その check が走らない PR でも正常動作する: rollup に現れない＝
          #   pending 集合に入らないだけで、待機対象が減るだけ（「無い場合も反応する」）。
          # - 自分自身（"evaluate" job）は実行中 IN_PROGRESS で rollup に
          #   居るので必ず除外する（自己待ちの deadlock 回避）。
          #
          # 背景（race）: 条件 4/5 の `.conclusion` 抽出は「rollup に不在」と「存在するが pending
          # （conclusion=null）」を区別できず、check 反映/完了前に evaluate が走ると未走行と誤判定して
          # skip していた（全 check 緑・clean なのに未 merge で滞留）。
          # event 依存にしない理由: GITHUB_TOKEN ベースの Actions の check_suite:completed は
          # loop 防止で本 workflow を再 trigger しない。ゆえに pending 検知→exit→event 待ちだと
          # 永続待機になる。よって step 内ポーリングで確定させる。
          POLL_MAX_WAIT=1500  # 最大待機秒（25min）。最長の check を同一 run 内で待ち切る。
                              # timeout-minutes(30) 内に merge まで収まる値に揃える。
          POLL_INTERVAL=15
          poll_elapsed=0
          while :; do
            # 自分（評価 job）を除く全 check のうち未完了
            # （CheckRun: status != COMPLETED / StatusContext: state == PENDING）の件数
            PENDING=$(echo "$PR_JSON" | jq -r '
              [ .statusCheckRollup[]?
                | select((.name // .context) != "evaluate")
                | select(
                    (.__typename == "CheckRun"      and .status != "COMPLETED") or
                    (.__typename == "StatusContext"  and .state  == "PENDING")
                  )
              ] | length')
            if [ "$PENDING" -eq 0 ]; then
              break   # 全 check 完了（or 自分以外不在）→ 条件 4 以降へ
            fi
            if [ "$poll_elapsed" -ge "$POLL_MAX_WAIT" ]; then
              echo "::notice::PR #$PR_NUMBER の CI が ${POLL_MAX_WAIT}s 経過しても未完了（pending=$PENDING 件）。skip（次の push/label/review event で再評価）。"
              exit 0
            fi
            # 待機中に人間が stop ラベルを付けた場合、ここで拾って即座に降りる。
            # これは応答性の改善ではなく **人間の停止意思が in-flight run に届く唯一の経路** である
            # （下記「第二の配線欠落」参照）。最大 POLL_INTERVAL 秒で反応する。
            LOOP_STOP=$(echo "$PR_JSON" | jq -r '[.labels[]? | select(.name == "do-not-merge" or .name == "human-review-needed" or .name == "pickup-failed")] | .[0].name // ""')
            if [ -n "$LOOP_STOP" ]; then
              echo "::notice::PR #$PR_NUMBER に待機中 stop ラベル '$LOOP_STOP' が付与された。skip（人間の停止意思を優先）。"
              exit 0
            fi
            echo "::notice::PR #$PR_NUMBER の CI 未完了（pending=$PENDING 件）。${POLL_INTERVAL}s 待機して再確認...（経過 ${poll_elapsed}s）"
            sleep "$POLL_INTERVAL"
            poll_elapsed=$((poll_elapsed + POLL_INTERVAL))
            # 最新の rollup を取り直す（後続の条件 4/5/6 もこの最新 PR_JSON を使う）。
            # gh の transient failure では前回 PR_JSON を保持して継続（red CI にしない設計）。
            if NEW_JSON=$(gh pr view "$PR_NUMBER" --json "$PR_FIELDS" 2>/dev/null); then
              PR_JSON="$NEW_JSON"
            else
              echo "::warning::gh pr view が一時失敗。前回 rollup で継続（次反復で再取得）。"
            fi
          done

          # 条件 4: harness-verify が走った場合は SUCCESS 必須（Copilot review #42 line 145）
          # 旧版は「SUCCESS 必須」と書いていたが、harness-verify.yml の paths filter は
          # `.claude/skills/**` `harness-verifier/**` のみで、history/** や workflow 変更
          # 単独の PR では発火しない → 永久 pending する事象を防ぐため「走った場合のみ
          # 必須」に緩和。zero-check auto-merge は条件 4.5 (下) で防ぐ
          # statusCheckRollup の name は workflow 内 job 名（"verify"）が入る
          HV=$(echo "$PR_JSON" | jq -r '.statusCheckRollup[]? | select(.name == "verify") | .conclusion' | tail -1)
          if [ -n "$HV" ] && [ "$HV" != "SUCCESS" ]; then
            echo "::notice::harness-verify=$HV (expected SUCCESS or 未実行)。skip。"
            exit 0
          fi

          # 条件 5: gemini-review が走った場合は SUCCESS 必須（paths filter で走らなければ skip 扱い）
          GR=$(echo "$PR_JSON" | jq -r '.statusCheckRollup[]? | select(.name == "review") | .conclusion' | tail -1)
          if [ -n "$GR" ] && [ "$GR" != "SUCCESS" ]; then
            echo "::notice::gemini-review=$GR (expected SUCCESS or 未実行)。skip。"
            exit 0
          fi

          # 条件 4.5: 最低 1 つの independent verifier が SUCCESS で走っていること
          # 両方 paths filter 外で zero-check 状態の PR を auto-merge してしまうのを防ぐ
          # （例: workflow 単独変更 PR で harness-verify も gemini-review も発火しない場合）
          if [ -z "$HV" ] && [ -z "$GR" ]; then
            echo "::notice::PR #$PR_NUMBER に harness-verify / gemini-review いずれも走っていない（paths filter 外）。skip（最低 1 verifier の SUCCESS 必須）。"
            exit 0
          fi

          # 条件 6: reviewDecision が CHANGES_REQUESTED でない
          RD=$(echo "$PR_JSON" | jq -r '.reviewDecision // ""')
          if [ "$RD" = "CHANGES_REQUESTED" ]; then
            echo "::notice::PR #$PR_NUMBER の reviewDecision=$RD。skip（指摘解消待ち）。"
            exit 0
          fi

          # 条件 1-3 の再判定（不可逆操作の直前・Council council-2026-08-26T04:04:34Z-amrace）
          #
          # なぜ必要か（PR #196 の実測、2026-08-26）:
          #   条件 1（stop ラベル）は L178 でポーリングループ **より前** に 1 回だけ評価される。
          #   その後ループが最大 POLL_MAX_WAIT=1500 秒（25 分）待つあいだにラベルが付いても、
          #   merge 直前に再判定されないため無視されていた。実測では human-review-needed を
          #   付与済みの PR が squash merge された。
          #
          # なぜ「取得済み PR_JSON の再利用」では不十分か:
          #   L220 のループは **既存の** PR_JSON から PENDING を算出して break する。初回反復で
          #   全 check が完了していれば再取得（L242）は一度も走らず、スナップショットは
          #   ループ突入前のまま古い。また L242 は gh 一時失敗時に前回値で継続するため、
          #   その値をそのまま停止判定に流用すると stale なまま merge しうる。
          #   ゆえにここで **明示的に取り直す**。
          #
          # fail-closed: 取得に失敗したら merge しない。停止判定の材料が無い状態で
          #   不可逆操作へ進まない（センサーが武装解除されたまま緑を装わない）。
          if ! FINAL_JSON=$(gh pr view "$PR_NUMBER" --json "$PR_FIELDS" 2>/dev/null); then
            echo "::notice::PR #$PR_NUMBER の最終確認で gh pr view に失敗。skip（fail-closed。停止判定の材料なしに merge しない）。"
            exit 0
          fi
          FINAL_STOP=$(echo "$FINAL_JSON" | jq -r '[.labels[]? | select(.name == "do-not-merge" or .name == "human-review-needed" or .name == "pickup-failed")] | .[0].name // ""')
          if [ -n "$FINAL_STOP" ]; then
            echo "::notice::PR #$PR_NUMBER に stop ラベル '$FINAL_STOP' あり（最終確認で検出）。skip。"
            exit 0
          fi
          if [ "$(echo "$FINAL_JSON" | jq -r '.isDraft')" = "true" ]; then
            echo "::notice::PR #$PR_NUMBER は draft（最終確認で検出）。skip。"
            exit 0
          fi
          FINAL_AUTHOR=$(echo "$FINAL_JSON" | jq -r '.author.login')
          if ! echo " $ALLOWED_AUTHORS " | grep -q " $FINAL_AUTHOR "; then
            echo "::notice::PR #$PR_NUMBER の author=$FINAL_AUTHOR は allowlist 外（最終確認で検出）。skip。"
            exit 0
          fi
          if [ "$(echo "$FINAL_JSON" | jq -r '.state')" != "OPEN" ]; then
            echo "::notice::PR #$PR_NUMBER は OPEN でない（最終確認で検出）。skip。"
            exit 0
          fi
          FINAL_RD=$(echo "$FINAL_JSON" | jq -r '.reviewDecision // ""')
          if [ "$FINAL_RD" = "CHANGES_REQUESTED" ]; then
            echo "::notice::PR #$PR_NUMBER の reviewDecision=$FINAL_RD（最終確認で検出）。skip（指摘解消待ち）。"
            exit 0
          fi

          # 条件 4 / 4.5 / 5（harness-verify / gemini-review の結論）を再判定しない理由:
          #   完了した check の conclusion は後から変わらず、かつ 4/4.5/5 は「ループを抜けた
          #   スナップショット＝全 check 完了」と同じ rollup から導かれている。人間が後から
          #   翻せる信号（stop ラベル / draft / CHANGES_REQUESTED）とは性質が異なるため、
          #   ここでの再判定対象は「人間が待機中に翻せるもの」に限る。

          # 残余リスク（塞ぎ切れていない・受容の明示）:
          #   上の gh pr view と下の gh pr merge の間には数秒の TOCTOU が原理的に残る。
          #   ラベルは client 側チェックであり、GitHub 側で merge と原子的に評価する手段が無い。
          #   本修正は窓を 25 分から数秒へ縮めるが「塞いだ」わけではない。
          #
          # 第二の配線欠落（本修正の射程外・別途検証）:
          #   concurrency.cancel-in-progress: false のため、人間のラベル付与が起こす labeled event の
          #   run は in-flight run の **後ろに queue** され、実行中の run を preempt できない。
          #   実測（PR #196）: labeled run の job created_at 03:45:58 は in-flight run の job 完了
          #   03:45:57 の 1 秒後で、merge 03:45:56 には間に合っていない。
          #   ゆえに外部 event は in-flight run を止められず、停止判定は必ず job 内に置く必要がある
          #   （上のループ内検査と本節がその実装）。
          TITLE=$(echo "$FINAL_JSON" | jq -r '.title')
          echo "::notice::全条件 pass。PR #$PR_NUMBER ($TITLE) を squash merge します（HV=${HV:-未実行}, GR=${GR:-未実行}）。"
          gh pr merge "$PR_NUMBER" --squash --delete-branch --subject "$TITLE (#$PR_NUMBER)"
          echo "::notice::PR #$PR_NUMBER の auto-merge 完了。"
